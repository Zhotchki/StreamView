{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streamview",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
